{
  "manifest_version": 3,
  "name": "Maps Lead Scraper",
  "short_name": "Maps Scraper",
  "version": "1.0.0",
  "description": "Extract business leads (name, rating, reviews, phone, website, Maps URL) from Google Maps search results locally and export them to CSV.",
  "permissions": ["storage", "downloads", "activeTab", "scripting"],
  "host_permissions": [
    "https://google.com/*",
    "https://*.google.com/*",
    "https://lemonsqueezy.com/*",
    "https://*.lemonsqueezy.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
